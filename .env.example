# Copy to .env and fill in. Never commit real values.

# --- Database ---
# Admin URL (migrations + seed only)
DATABASE_URL=postgres://zpass:zpass@localhost:5432/zpass
# Per-service role URLs (docs/05-BACKEND-SCHEMA.md: the roles are separate by design)
ISSUER_DATABASE_URL=postgres://zpass_issuer:change-me@localhost:5432/zpass
VERIFIER_DATABASE_URL=postgres://zpass_verifier:change-me@localhost:5432/zpass
# 32+ random bytes for pgcrypto-encrypted columns (holder addresses)
ZPASS_DATA_KEY=
ZPASS_ENV=development

# --- Issuer ---
ISSUER_PORT=8787
ISSUER_ADMIN_API_KEY=
ZPASS_EPOCHS_PAUSED=false

# --- Verifier ---
VERIFIER_PORT=8788
# ES256 private key (PEM) for Sign in with zPass ID tokens
OIDC_SIGNING_KEY=
# Dev API key seeded for the demo app
DEV_APP_API_KEY=zpk_dev_00000000000000000000000000000000

# --- Telegram bot ---
BOT_PORT=8789
TELEGRAM_BOT_TOKEN=
ZPASS_WEB_URL=http://localhost:3000
VERIFIER_URL=http://localhost:8788

# --- Beacon (crates/zpass-beacon) ---
ZPASS_NETWORK=testnet
ZPASS_ZAINO_URL=http://localhost:8137
# Spending seed for the beacon + challenge wallet (small balance only). Prefer a Docker secret.
ZPASS_BEACON_SEED=
# Public by design: published in the README and on /beacon
ZPASS_BEACON_UFVK=

# --- Seed ---
# Comma-separated testnet UAs from team test wallets, for mock holders
SEED_HOLDER_UAS=

# --- Web ---
NEXT_PUBLIC_ISSUER_URL=http://localhost:8787
NEXT_PUBLIC_VERIFIER_URL=http://localhost:8788
NEXT_PUBLIC_BOT_URL=http://localhost:8789

# --- Infra ---
POSTGRES_PASSWORD=zpass
ZEBRA_NETWORK=Testnet
ZEBRA_IMAGE=zfnd/zebra:latest
# Pin in task 1.3 once an NU7-capable Zaino release is chosen
ZAINO_IMAGE=
ZPASS_IMAGE_TAG=latest
